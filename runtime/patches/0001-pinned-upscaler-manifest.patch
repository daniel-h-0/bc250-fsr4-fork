 __manifest_url = 'https://loathingkernel.github.io/proton-upscalers/manifest.json'
 __manifest_json: Union[dict, None] = None
+__manifest_path: Union[Path, None] = None
+
+
+def __sha256_matches(path: Path, checksum: str) -> bool:
+    if path.is_symlink() or not path.is_file():
+        return False
+    with path.open('rb') as file_fd:
+        return hashlib.file_digest(file_fd, 'sha256').hexdigest() == checksum.lower()
+
+
+def __valid_sha256(checksum: str) -> bool:
+    return (isinstance(checksum, str) and len(checksum) == 64
+            and all(c in '0123456789abcdefABCDEF' for c in checksum))
+
+
+def __pinned_item(item: dict, upscaler: str) -> dict:
+    item = item.copy()
+    hashes = item.get('sha256_hash')
+    if upscaler == 'optiscaler':
+        if not isinstance(hashes, dict) or not hashes:
+            raise RuntimeError('Pinned OptiScaler requires critical-file SHA256 hashes')
+        for name in item['md5_hash']:
+            if not name.endswith('.ini') and name not in hashes:
+                raise RuntimeError(f'Missing pinned SHA256 for {name}')
+        for name in hashes:
+            if Path(name).is_absolute() or '..' in Path(name).parts:
+                raise RuntimeError(f'Unsafe pinned filename: {name}')
+        checksums = list(hashes.values())
+    else:
+        checksums = [hashes]
+    checksums.append(item.get('zip_sha256_hash'))
+    if not all(__valid_sha256(value) for value in checksums):
+        raise RuntimeError(f'Invalid or missing pinned SHA256 for {upscaler}')
+
+    url = urlparse(item['download_url'])
+    if not url.scheme:
+        relative = Path(unquote(url.path))
+        if relative.is_absolute() or '..' in relative.parts or url.netloc or url.query or url.fragment:
+            raise RuntimeError('Pinned artifact must stay inside the manifest directory')
+        base = __manifest_path.parent.resolve()
+        artifact = (base / relative).resolve(strict=True)
+        if not artifact.is_relative_to(base):
+            raise RuntimeError('Pinned artifact escapes the manifest directory')
+        item['download_url'] = artifact.as_uri()
+    url = urlparse(item['download_url'])
+    artifact = Path(unquote(url.path))
+    if (url.scheme != 'file' or url.netloc not in {'', 'localhost'}
+            or url.query or url.fragment or not artifact.is_absolute()):
+        raise RuntimeError('Pinned artifacts require local file URLs or relative paths')
+    if not __sha256_matches(artifact, item['zip_sha256_hash']):
+        raise RuntimeError(f'Pinned archive SHA256 mismatch or missing file: {artifact.name}')
+    return item
 
 
 def __get_manifest() -> dict:
     global __manifest_json
     if __manifest_json is not None:
+        return __manifest_json
+
+    if __manifest_path is not None:
+        with __manifest_path.open(encoding='utf-8') as manifest_fd:
+            manifest = json.load(manifest_fd)
+        if not isinstance(manifest, dict):
+            raise RuntimeError('Pinned upscaler manifest must be a JSON object')
+        __manifest_json = manifest
         return __manifest_json
 
     cache_dir = config.path.cache_dir.joinpath('upscalers')
